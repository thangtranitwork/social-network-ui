  "privacy": {
    "title": "Privacy Policy & Data Transparency",
    "subtitle": "PocPoc's commitment to protecting your privacy, data transparency, and user rights.",
    "lastUpdated": "Updated November 11, 2026",
    "backHome": "Back to Home",
    "login": "Login",
    "register": "Sign Up",
    "tableOfContents": "Table of Contents",
    "badge": "Privacy Policy",
    "viewHistoryLink": "Open View History in Settings",
    "copiedEmail": "Email copied to clipboard!",
    "copyEmail": "Copy email address",
    "sections": {
      "intro": {
        "title": "1. Core Privacy Principles",
        "p1": "At PocPoc, we believe privacy is a fundamental human right in the digital space. We only collect the minimal data necessary to deliver core features, safeguard your account, and enhance your user experience.",
        "p2": "We never silently harvest data for invasive advertising or cross-site tracking."
      },
      "accountData": {
        "title": "2. Account Data & Personal Information",
        "p1": "When you create an account on PocPoc, we collect information you voluntarily provide: Full name, Username, Email address, Birthdate (to comply with age requirements), and Password.",
        "p2": "Passwords are securely hashed before database storage. You can update your profile picture, bio, and personal details anytime in Account Settings."
      },
      "viewTelemetry": {
        "title": "3. View Recording & Feed Personalization",
        "p1": "To provide a relevant feed and avoid repetitive content, our system only records a post as viewed when you pause to read it on screen while the app is active.",
        "p2": "View history is securely stored and automatically deleted permanently after 90 days. This data strictly serves two purposes: (1) Providing your View History feature under Settings; (2) Reducing repetitive posts you have already read on your Newsfeed."
      },
      "messages": {
        "title": "4. Secure Messaging & Calls",
        "p1": "Private conversations between users are safeguarded with end-to-end encryption. PocPoc servers act as relay conduits and cannot decipher the plaintext contents of your messages.",
        "p2": "Audio and video calls are transmitted directly between devices via secure peer-to-peer protocols. No call audio or video is recorded or saved on our servers."
      },
      "sharing": {
        "title": "5. Zero Data Broker Guarantee",
        "p1": "PocPoc strictly guarantees: We NEVER sell, lease, or transfer your personal data or usage patterns to any advertising brokers or third parties.",
        "p2": "Information is only disclosed when strictly mandated by valid legal processes issued by authorized governmental authorities."
      },
      "userRights": {
        "title": "6. Your Rights & Data Controls",
        "p1": "Audit Right: You can review the complete history of posts you have viewed in the last 90 days under Settings -> Post View History.",
        "p2": "Interaction Controls: You can block users, remove connections, and set visibility permissions for each post (Public, Friends, or Only Me).",
        "p3": "Deletion Right: You can delete individual posts, comments, or permanently close your account anytime. Upon account closure, all associated identifiable data is purged securely."
      },
      "locationTelemetry": {
        "title": "7. Location (GPS), IP Address & Device Information",
        "p1": "IP & Device Telemetry: When you sign in or use PocPoc, we collect your IP address, device identifier, platform, OS version, and app version to protect against unauthorized logins, prevent abuse, and infer approximate city-level region.",
        "p2": "GPS Location & People Nearby: Precise GPS coordinates are collected only when you grant browser/device permission. 'People Nearby' is OFF by default and strictly opt-in; active discovery entries in our cache automatically expire after 15–30 minutes or immediately when you turn it off. Other users only see rounded distances (e.g., '< 500m', '~1.2 km') and never your exact coordinates.",
        "p3": "Persistent Analytics & Map Providers: Technical telemetry logs (IP, device metadata, and location events while using location features) are securely retained for up to 180 days for security auditing, fraud prevention, and service analytics. Map visualizations may use tiles from Carto, OpenStreetMap, or Google Maps subject to their respective terms."
      },
      "contact": {
        "title": "8. Contact & Support",
        "p1": "If you have questions, feedback, or concerns regarding our privacy practices, please contact our team at: privacy@pocpoc.online."
      }
    }
  }
